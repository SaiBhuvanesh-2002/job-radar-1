# Job Radar — local secrets. Copy to .env and fill in.
# .env is gitignored. .env.example IS committed — do NOT put real keys here.

# Gmail account that owns the App Password (the sender)
GMAIL_USER=you@gmail.com

# 16-char App Password (Google Account > Security > App passwords).
# Requires 2-Step Verification to be enabled first.
GMAIL_APP_PASS=xxxxxxxxxxxxxxxx

# Optional: send alerts to a different address than GMAIL_USER
# ALERT_TO=alerts@example.com

# Optional: lower for more verbose logs
# LOG_LEVEL=DEBUG

# --- v2: Gemini scoring ---
# Google AI Studio API key (https://aistudio.google.com/apikey) — NOT a Vertex AI key.
# Leave blank to disable scoring; pipeline falls back to UNSCORED email.
GEMINI_API_KEY=

# Optional: override the default model (gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash

# Resume content for scoring. Either:
#   1. Create resume.md in the repo root (gitignored, preferred for local), OR
#   2. Set RESUME_CONTENT here (the env var wins if both are present — CI uses this).
# RESUME_CONTENT="..."
